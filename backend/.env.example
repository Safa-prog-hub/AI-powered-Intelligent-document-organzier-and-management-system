# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────
# Local development (no Docker):
MONGODB_URI=mongodb://localhost:27017/doc_organizer
# Docker Compose (Phase 8):
# MONGODB_URI=mongodb://mongo-db:27017/doc_organizer

# ── JWT Authentication ────────────────────────────────────────────────────
# !! Generate a strong secret in production: openssl rand -hex 32
JWT_SECRET=dev_only_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# ── Python AI microservice ────────────────────────────────────────────────
# Local development (no Docker):
AI_SERVICE_URL=http://localhost:8000
# Docker Compose (Phase 8):
# AI_SERVICE_URL=http://python-ai:8000
AI_TIMEOUT_MS=120000

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=15728640
